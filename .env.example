# Database
DATABASE_URL=postgresql://commerce:commerce_dev_password@localhost:5432/digital_commerce

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# AWS S3 (Production)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BUCKET_NAME=digital-commerce-files
AWS_REGION=us-east-1

# LocalStack S3 (Development)
# AWS_ENDPOINT=http://localhost:4566
# AWS_S3_FORCE_PATH_STYLE=true

# Email Service
EMAIL_PROVIDER=sendgrid  # sendgrid or resend
SENDGRID_API_KEY=your_sendgrid_api_key
# RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=noreply@yourplatform.com
FROM_NAME=Digital Commerce Platform

# MailHog (Development)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=

# Redis
REDIS_URL=redis://localhost:6379

# Application
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Security
BCRYPT_ROUNDS=12
MAX_DOWNLOAD_COUNT=10
DOWNLOAD_LINK_EXPIRY_DAYS=30

# File Upload
MAX_FILE_SIZE=524288000  # 500MB in bytes
ALLOWED_FILE_TYPES=.pdf,.epub,.zip,.mp4,.mov,.avi,.jpg,.png

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring (Optional)
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=
